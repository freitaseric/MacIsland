{
  "sourceLanguage": "en",
  "strings": {
    "about.credits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notch player for Spotify.\nNot affiliated with Spotify or Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um player no notch para o Spotify.\nNão afiliado ao Spotify ou à Apple."
          }
        }
      }
    },
    "button.check_again": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificar"
          }
        }
      }
    },
    "button.collapse": {
