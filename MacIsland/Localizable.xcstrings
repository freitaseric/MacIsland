          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar ilha"
          }
        }
      }
    },
    "status.connecting.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for permission and the current track…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando permissão e os dados da faixa atual…"
          }
        }
      }
    },
    "status.connecting.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to Spotify"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando ao Spotify"
          }
        }
      }
    },
    "status.nothing_playing.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a song in Spotify to see the details."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê play em uma música no Spotify para ver os detalhes."
          }
        }
      }
    },
    "status.nothing_playing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing playing"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada tocando agora"
          }
        }
      }
    },
    "status.permission.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacIsland in System Settings › Privacy & Security › Automation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorize o MacIsland em Ajustes do Sistema › Privacidade e Segurança › Automação."
          }
        }
      }
    },
    "status.permission.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission needed"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão necessária"
          }
        }
      }
    },
    "status.read_error.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't talk to Spotify."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível falar com o Spotify."
          }
        }
      }
    },
    "status.read_error.malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify returned an unexpected response."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Spotify respondeu em um formato inesperado."
          }
        }
      }
    },
    "status.read_error.timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify took too long to respond. Try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Spotify demorou para responder. Tente novamente."
          }
        }
      }
    },
    "status.read_error.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read Spotify"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o Spotify"
          }
        }
      }
    },
    "status.spotify_closed.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Spotify to control your music from here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Spotify para controlar a música por aqui."
          }
        }
      }
    },
    "status.spotify_closed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify isn't open"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify não está aberto"
          }
        }
      }
    }
  },
  "version": "1.0"
}
