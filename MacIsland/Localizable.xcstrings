    "error.applescript_code.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScript returned error %d."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AppleScript retornou o erro %d."
          }
        }
      }
    },
    "error.no_response": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify didn't return a response."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Spotify não retornou uma resposta."
          }
        }
      }
    },
    "login_item.error.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS reported: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS informou: %@"
          }
        }
      }
    },
    "login_item.error.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't update Open at Login"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar “Abrir no login”"
          }
        }
      }
    },
    "login_item.requires_approval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve MacIsland in System Settings › General › Login Items."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove o MacIsland em Ajustes do Sistema › Geral › Itens de Login."
          }
        }
      }
    },
    "menu.about": {
      "localizations": {
        "en": {
